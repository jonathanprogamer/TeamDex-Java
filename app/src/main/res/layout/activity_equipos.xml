<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101827"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="700dp">

            <Button
                android:id="@+id/btnVolverEquipos"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#263449"
                android:text="← Volver"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="MIS EQUIPOS"
                android:textColor="#FACC15"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCantidadEquipos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tus equipos Pokémon"
                android:textColor="#CBD5E1"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/contenedorEquipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtSinEquipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="Todavía no tienes equipos creados."
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCrearEquipo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#2563EB"
                android:text="Crear equipo"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
