<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101827"
    android:padding="16dp">

    <Button
        android:id="@+id/btnVolverPokedex"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:backgroundTint="#263449"
        android:text="← Volver"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="POKÉDEX"
        android:textColor="#FACC15"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabPokemon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FACC15"
            android:text="Pokémon"
            android:textColor="#101827"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabFavoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#263449"
            android:text="Favoritos"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnIrRegion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#263449"
        android:text="Explorar regiones  ▼"
        android:textColor="#FACC15"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <EditText
        android:id="@+id/edtBuscarPokemon"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_panel"
        android:hint="Buscar por nombre o número..."
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch" />

    <TextView
        android:id="@+id/txtEstadoPokemon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="15dp"
        android:text="Cargando Pokémon..."
        android:textColor="#CBD5E1"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPokemon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="15dp"
        android:scrollbars="vertical" />

</LinearLayout>
